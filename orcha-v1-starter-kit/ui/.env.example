# Smart AI Router (free tiers). A live free model ranked at/above GPT-5.6 (Ox Alpha) takes all work.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
