:root {
  /* DESIGN.md obsidian palette. Token names are the old wireframe names so the
     rest of this file keeps working; values now carry the documented roles.
     --fill-3 (#1a2130) is derived as one step above Elevated — not in DESIGN.md. */
  color-scheme: dark;
  --paper: #0b0d12;      /* Canvas */
  --ink: #edf0f5;        /* Text */
  --muted: #8d96a8;      /* Muted text */
  --line: #252b36;       /* Border */
  --soft: #252b36;       /* soft dashed placeholders read as quiet borders */
  --fill: #11141b;       /* Surface */
  --fill-2: #151923;     /* Elevated surface */
  --fill-3: #1a2130;     /* one step above elevated (derived) */
  --note: #8d96a8;       /* fine print uses the muted role */
  --violet: #9b8cff;     /* Violet orchestration */
  --mint: #62d9b1;       /* Mint verified */
  --amber: #eab365;      /* Amber experiment */
  --coral: #ef7d83;      /* Coral recovery/failure */
  --blue: #6fa8e9;       /* Blue preview/information */
  font-family: "DM Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  color: var(--ink);
  background: var(--paper);
}

* { box-sizing: border-box; }
html, body, #root { margin: 0; min-height: 100%; }
body { background: var(--paper); }
button, input, textarea, select { font: inherit; color: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
  outline: 2px solid var(--ink);
  outline-offset: 2px;
}

.app {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  grid-template-rows: auto 1fr;
  min-height: 100vh;
}

.wf-banner {
  grid-column: 1 / -1;
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 8px 16px;
  border-bottom: 1px solid var(--line);
  background: var(--fill-2);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.wf-banner strong { letter-spacing: 0; text-transform: none; font-size: 12px; }

.rail {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 16px 12px;
  border-right: 1px solid var(--line);
  background: var(--fill);
}
.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  letter-spacing: -0.03em;
}
.brand-box {
  width: 18px;
  height: 18px;
  border: 1px solid var(--line);
}
.company-chip, .user-chip {
  display: grid;
  grid-template-columns: 28px 1fr;
  gap: 8px;
  align-items: center;
  padding: 8px;
  border: 1px dashed var(--soft);
  font-size: 12px;
}
.avatar {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border: 1px solid var(--line);
  font-size: 10px;
  font-weight: 700;
}
.company-chip small, .user-chip small, .muted { color: var(--muted); }
.nav { display: grid; gap: 4px; }
.nav-item, .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid var(--line);
  background: var(--fill);
  text-align: left;
}
.nav-item { width: 100%; justify-content: flex-start; }
.nav-item.active { background: var(--fill-2); font-weight: 700; }
.nav-item:disabled { opacity: 0.45; }
.rail-foot { margin-top: auto; display: grid; gap: 8px; }
.note-label {
  margin: 0 0 6px;
  color: var(--note);
  font-size: 10px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.main { min-width: 0; display: flex; flex-direction: column; }
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 56px;
  padding: 8px 24px;
  border-bottom: 1px solid var(--line);
  background: var(--fill);
}
.crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--muted); }
.crumbs strong { color: var(--ink); font-weight: 600; }
.top-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 28px;
  padding: 0 8px;
  border: 1px solid var(--line);
  background: var(--fill-2);
  font-size: 11px;
}
.page { padding: 24px; display: grid; gap: 16px; }

.region {
  position: relative;
  padding: 20px 16px 16px;
  border: 1px solid var(--line);
  background: var(--fill);
}
.region-label {
  position: absolute;
  top: -8px;
  left: 10px;
  padding: 0 6px;
  background: var(--fill);
  color: var(--note);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.wf-note {
  margin: 0;
  color: var(--note);
  font-size: 12px;
  font-style: italic;
}
.placeholder {
  min-height: 36px;
  border: 1px dashed var(--soft);
  background: repeating-linear-gradient(-45deg, transparent, transparent 6px, var(--fill-2) 6px, var(--fill-2) 7px);
}
.placeholder.lg { min-height: 88px; }
.row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
.stack { display: grid; gap: 12px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.grid-home { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.split { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.9fr); gap: 16px; }

h1, h2, h3, p { margin: 0; }
h1 { font-size: 28px; font-weight: 600; letter-spacing: -0.03em; }
h2 { font-size: 18px; font-weight: 600; }
h3 { font-size: 14px; font-weight: 600; }
/* DESIGN.md typography: Space Grotesk carries product statements and labels,
   DM Sans (see :root) carries supporting copy. */
h1, h2, h3, .brand { font-family: "Space Grotesk", "DM Sans", sans-serif; }
p { color: var(--ink); font-size: 14px; line-height: 1.45; }
.btn.primary { background: var(--ink); color: var(--fill); }
.btn.ghost { background: transparent; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }

.intent-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
.intent {
  display: grid;
  gap: 8px;
  min-height: 110px;
  padding: 12px;
  border: 1px solid var(--line);
  background: var(--fill);
  text-align: left;
}
.intent.selected { background: var(--fill-2); outline: 2px solid var(--ink); }
.intent span { color: var(--muted); font-size: 12px; }

label.field { display: grid; gap: 6px; font-size: 12px; font-weight: 600; }
input, textarea, select {
  width: 100%;
  padding: 10px;
  border: 1px solid var(--line);
  background: var(--fill);
}
textarea { min-height: 120px; resize: vertical; }

.plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.block {
  display: grid;
  gap: 8px;
  padding: 12px;
  border: 1px solid var(--line);
}
.block.dash { border-style: dashed; }

.team-row { display: flex; gap: 8px; flex-wrap: wrap; }
.person {
  display: grid;
  justify-items: center;
  gap: 4px;
  width: 72px;
  font-size: 11px;
}

.meter {
  height: 10px;
  border: 1px solid var(--line);
  background: var(--fill-2);
}
.meter > span { display: block; height: 100%; width: 18%; background: var(--fill-3); border-right: 1px solid var(--line); }

.map {
  position: relative;
  min-height: 460px;
  border: 1px dashed var(--soft);
  background:
    linear-gradient(var(--fill-2) 1px, transparent 1px),
    linear-gradient(90deg, var(--fill-2) 1px, transparent 1px);
  background-size: 24px 24px;
}
.edge {
  position: absolute;
  height: 1px;
  background: var(--line);
}
.edge-label {
  position: absolute;
  padding: 2px 4px;
  background: var(--fill);
  border: 1px solid var(--line);
  font-size: 10px;
  white-space: nowrap;
}
.node {
  position: absolute;
  display: grid;
  gap: 4px;
  width: 170px;
  padding: 10px;
  border: 1px solid var(--line);
  background: var(--fill);
  text-align: left;
}
.node.center {
  top: 50%;
  left: 50%;
  width: 180px;
  transform: translate(-50%, -50%);
}
.node.idle { background: var(--fill-2); }
.node.selected { outline: 2px solid var(--ink); }
.node small { color: var(--muted); }
.node-eng { top: 24px; left: 24px; }
.node-research { top: 24px; right: 24px; }
.node-design { bottom: 24px; left: 24px; }
.node-qa { bottom: 24px; right: 24px; }
.edge-a { top: 38%; left: 22%; width: 18%; transform: rotate(18deg); }
.edge-b { top: 38%; right: 22%; width: 18%; transform: rotate(-18deg); }
.edge-c { top: 62%; left: 22%; width: 18%; transform: rotate(-18deg); }
.edge-d { top: 62%; right: 22%; width: 18%; transform: rotate(18deg); }
.el-a { top: 32%; left: 28%; }
.el-b { top: 32%; right: 28%; }
.el-c { top: 66%; left: 28%; }
.el-d { top: 66%; right: 28%; }

.list { display: grid; }
.item {
  display: grid;
  grid-template-columns: 72px 1fr auto;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid var(--fill-3);
  font-size: 13px;
}
.item:last-child { border-bottom: 0; }
.item b { display: block; }
.item p { color: var(--muted); font-size: 12px; }

.tree {
  position: relative;
  min-height: 380px;
  padding: 16px;
}
.tree-line {
  position: absolute;
  left: 36px;
  top: 48px;
  bottom: 48px;
  width: 1px;
  background: var(--line);
}
.tree-node {
  display: grid;
  grid-template-columns: 16px 1fr;
  gap: 12px;
  margin: 12px 0 12px 28px;
  padding: 10px;
  border: 1px solid var(--line);
  background: var(--fill);
  text-align: left;
}
.tree-node.selected { outline: 2px solid var(--ink); }
.dot {
  width: 12px;
  height: 12px;
  margin-top: 4px;
  border: 1px solid var(--line);
  background: var(--fill-3);
  border-radius: 50%;
}
.metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 12px; }

.tabs { display: flex; flex-wrap: wrap; gap: 4px; }
.tab {
  min-height: 36px;
  padding: 0 10px;
  border: 1px solid var(--line);
  background: var(--fill);
}
.tab.active { background: var(--fill-2); font-weight: 700; }
.table { width: 100%; border-collapse: collapse; font-size: 13px; }
.table th, .table td { padding: 8px; border: 1px solid var(--line); text-align: left; }
.table th { background: var(--fill-2); font-weight: 600; }

.backdrop {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  justify-content: flex-end;
  background: rgba(0, 0, 0, 0.18);
}
.backdrop.center { justify-content: center; align-items: center; }
.drawer, .modal {
  width: min(420px, 100vw);
  height: 100%;
  padding: 20px;
  border-left: 1px solid var(--line);
  background: var(--fill);
  overflow: auto;
}
.modal {
  height: auto;
  max-width: 480px;
  border: 1px solid var(--line);
}

.cost-bar {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
  align-items: center;
}
.tier {
  display: inline-block;
  padding: 2px 6px;
  border: 1px solid var(--line);
  font-size: 10px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

@media (max-width: 1100px) {
  .grid-home, .grid-3, .plan-grid, .split, .grid-2 { grid-template-columns: 1fr; }
}
@media (max-width: 820px) {
  .app { grid-template-columns: 72px 1fr; }
  .brand span, .company-chip div, .user-chip div, .nav-item span, .note-label { display: none; }
  .nav-item { justify-content: center; padding: 0; }
  .page { padding: 16px; }
  .map { min-height: 520px; }
}

/* Focused ChatGPT-style entry surface */
.chat-mode { display: block; min-height: 100vh; overflow: visible; background: #212121; color: #edf0f5; text-transform: uppercase; }
.chat-mode .gpt-composer,
.chat-mode .gpt-composer textarea,
.chat-mode .gpt-composer textarea::placeholder { text-transform: none; }
.chat-mode .main { min-height: 100vh; overflow: visible; }
.chat-mode .topbar { position: relative; z-index: 22; display: flex; align-items: center; justify-content: space-between; height: 68px; padding: 0 28px; border-bottom: 1px solid rgba(255,255,255,.08); background: #212121; }
.chat-mode .chat-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  text-decoration: none;
  font: 600 17px 'Space Grotesk', sans-serif;
  letter-spacing: -.02em;
  text-transform: none;
  cursor: pointer;
}
.chat-mode .chat-side {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: min(288px, 86vw);
  padding: 76px 14px 16px;
  background: #0B0D12;
  border-right: 1px solid #252B36;
  transform: translateX(-100%);
  text-transform: none;
  color: #EDF0F5;
}
.chat-side-top { padding: 0 2px 4px; }
.chat-side-new {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 44px;
  padding: 10px 14px;
  border: 1px solid #252B36;
  border-radius: 12px;
  background: #151923;
  color: #EDF0F5;
  font: 500 14px 'Space Grotesk', sans-serif;
  letter-spacing: -.01em;
  text-align: left;
}
.chat-side-new span { color: #9B8CFF; font-size: 18px; line-height: 1; }
.chat-side-new:hover { background: #1a2030; }
.chat-side-new:focus-visible,
.chat-side-item:focus-visible,
.chat-side-company:focus-visible {
  outline: 2px solid #9B8CFF;
  outline-offset: 2px;
}
.chat-side-list { flex: 1; overflow: auto; display: grid; align-content: start; gap: 4px; }
.chat-side-here { display: grid; gap: 2px; padding: 4px 0 8px; }
.chat-side-label {
  margin: 10px 10px 4px;
  color: #8D96A8;
  font: 500 11px/1.2 'Space Grotesk', sans-serif;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.chat-side-company {
  display: grid;
  grid-template-columns: 28px 1fr;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 44px;
  padding: 6px 10px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
  color: #EDF0F5;
  text-align: left;
  cursor: pointer;
}
.chat-side-company.is-current {
  background: #11141B;
  border-color: #252B36;
}
.chat-side-company:hover { background: #151923; }
.chat-side-company-mark {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: #151923;
  color: #9B8CFF;
  font: 600 12px 'Space Grotesk', sans-serif;
}
.chat-side-company.is-current .chat-side-company-mark { background: rgba(155,140,255,.14); }
.chat-side-company-copy { display: grid; gap: 1px; min-width: 0; }
.chat-side-company-copy strong {
  font: 500 13.5px/1.25 'Space Grotesk', sans-serif;
  letter-spacing: -.01em;
}
.chat-side-company-copy small {
  color: #8D96A8;
  font: 400 11.5px/1.3 'DM Sans', sans-serif;
}
.chat-side-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 44px;
  padding: 8px 12px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #EDF0F5;
  font: 400 14px/1.35 'DM Sans', sans-serif;
  text-align: left;
  text-decoration: none;
  cursor: pointer;
}
.chat-side-item:hover { background: #151923; }
.chat-side-item.is-here { color: #9B8CFF; }
.chat-side-foot { padding-top: 8px; border-top: 1px solid #252B36; }
.chat-side-you { color: #EDF0F5; font: 500 14px 'Space Grotesk', sans-serif; }
.chat-side-dim {
  position: fixed;
  inset: 0;
  z-index: 19;
  border: 0;
  background: rgba(11, 13, 18, .55);
}
.chat-mode .brand-box { width: 19px; height: 19px; border: 0; border-radius: 5px; background: linear-gradient(145deg, #aa9fff, #6655d4); box-shadow: 0 0 18px rgba(155,140,255,.32); transform: skew(-14deg); }
.chat-mode .top-meta { display: flex; align-items: center; gap: 14px; }.chat-mode .pill { border: 1px solid rgba(98,217,177,.18); border-radius: 999px; color: #62d9b1; background: rgba(98,217,177,.08); }.chat-mode .page { max-width: none; padding: 0; overflow: visible; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
.chat-entry { width: min(768px, calc(100% - 32px)); min-height: calc(100vh - 68px); margin: 0 auto; padding: 18vh 0 48px; display: flex; flex-direction: column; align-items: center; overflow: visible; }
.chat-title { display: flex; align-items: baseline; justify-content: center; width: 100%; max-width: 100%; margin: 0 0 36px; padding: 1.4em 28px; overflow: visible; font: 700 clamp(24px, 4.2vw, 44px)/1.1 'Space Grotesk', sans-serif; letter-spacing: -.02em; -webkit-font-smoothing: antialiased; }
.flip-line {
  position: relative;
  display: block;
  max-width: 100%;
  padding: .25em .35em .25em 0;
  overflow: visible;
  white-space: nowrap;
  text-align: center;
}
.flip-measures {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0;
  pointer-events: none;
  display: flex;
}
.flip-measure {
  white-space: nowrap;
}
.flip-stage {
  --flip-r: .5em;
  position: relative;
  z-index: 3;
  display: inline-block;
  overflow: visible;
  vertical-align: baseline;
  perspective: 900px;
  transform-style: preserve-3d;
  color: #3d7ec4;
}
.flip-cube {
  display: block;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transform-origin: center center;
}
.flip-verb,
.flip-bottom,
.chat-title-lead,
.flip-q {
  font: inherit;
  letter-spacing: inherit;
  line-height: inherit;
}
.flip-front {
  display: inline-block;
  color: #3d7ec4;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: translateZ(var(--flip-r));
}
.flip-bottom {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: baseline;
  color: #3d7ec4;
  white-space: nowrap;
  visibility: hidden;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: rotateX(-90deg) translateZ(var(--flip-r));
}
.hollow-wrap {
  position: relative;
  display: inline-block;
}
.hollow-sizer {
  color: #3d7ec4;
}
.flip-front .hollow-sizer,
.flip-bottom .hollow-sizer {
  color: #3d7ec4;
}
.hollow-glyph {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  font: inherit;
  letter-spacing: inherit;
}
.hollow-glyph text {
  font: inherit;
  letter-spacing: inherit;
}
.flip-stage.is-flipping .flip-bottom { visibility: visible; }
.chat-title-lead {
  display: inline-block;
  margin-right: .3em;
  color: #edf0f5;
}
.flip-q {
  display: inline-block;
  margin-left: .22em;
  padding-right: .2em;
  vertical-align: baseline;
  color: #edf0f5;
}
.chat-title-lead, .flip-verb, .flip-q { white-space: nowrap; }

.gpt-composer {
  width: 100%;
  padding: 10px 12px 10px;
  border: 1px solid #3e3e3e;
  border-radius: 28px;
  background: #303030;
  box-shadow: 0 0 0 1px rgba(255,255,255,.04), 0 8px 28px rgba(0, 0, 0, .28);
}
.gpt-composer:focus-within { border-color: #4b5568; }
.gpt-composer textarea {
  display: block;
  width: 100%;
  min-height: 28px;
  max-height: 180px;
  padding: 8px 10px 6px;
  border: 0;
  outline: 0;
  resize: none;
  field-sizing: content;
  background: transparent;
  color: #edf0f5;
  font: 400 16px/1.5 'DM Sans', sans-serif;
}
.gpt-composer textarea::placeholder { color: #8b93a3; }
.gpt-composer-bar { display: flex; align-items: center; gap: 10px; padding: 4px 2px 2px; color: #8b93a3; font-size: 12px; }
.gpt-composer-bar span { flex: 1; }
.gpt-icon, .gpt-send {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #d5dae4;
}
.gpt-icon { border: 1px solid #3a4252; font-size: 20px; line-height: 1; }
.gpt-icon:hover { background: #2b3140; }
.gpt-send { background: #ececec; color: #0b0d12; }
.gpt-send:hover { background: #fff; }
.gpt-send:disabled { opacity: .35; cursor: not-allowed; }

@media (max-width: 560px) {
  .chat-mode .topbar { padding: 0 17px; }
  .chat-entry { width: calc(100% - 28px); padding-top: 12vh; }
  .chat-title { font-size: 28px; }
}

/* Minimal chat-only landing state */
.chat-mode .page {
  position: relative;
  flex: 1;
  min-height: calc(100vh - 68px);
  padding: 0;
}
.chat-mode .chat-entry {
  position: relative;
  min-height: calc(100vh - 68px);
