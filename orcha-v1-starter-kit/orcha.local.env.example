# Copy to orcha.local.env. Keep that private file out of source control.
# These values are read by the API process only. A provider-specific model lets
# different temporary keys use their own model identifiers in one fallback chain.
# Direct uvicorn loads this file automatically. Set ORCHA_DISABLE_LOCAL_ENV=true
# in the process environment to force an explicit hosted/container secret source.
ORCHA_LOCAL_ENV_FILE=
ORCHA_DISABLE_LOCAL_ENV=false
ORCHA_AGENT_PROVIDER=gemini
ORCHA_AGENT_MODEL=
ORCHA_AGENT_GEMINI_MODEL=
ORCHA_AGENT_GROQ_MODEL=
ORCHA_AGENT_OPENROUTER_MODEL=
ORCHA_AGENT_FALLBACK_PROVIDERS=groq,openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional ordered comma-separated pools for temporary free-tier keys. Keep
# these only in this private API-host file; never put them in Vite env values.
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
OPENAI_API_KEYS=
# Failed temporary keys are skipped briefly in-memory before a recovery retry.
ORCHA_AGENT_KEY_COOLDOWN_SECONDS=60

# Optional private API/worker control-plane secret. For a shared/container
# worker, set a high-entropy value on both services and enable required mode.
ORCHA_WORKER_AUTH_TOKEN=
ORCHA_REQUIRE_WORKER_AUTH=false

# Bound autonomous work before you enable it.
ORCHA_MAX_AGENT_RUNS_PER_DAY=40
ORCHA_MAX_COMPANY_BUDGET_USD=25
