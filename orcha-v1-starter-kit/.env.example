ORCHA_ENV=development
# Direct uvicorn loads this optional ignored file from the starter-kit root.
# Set true in hosted/container environments that should use process secrets only.
ORCHA_LOCAL_ENV_FILE=
ORCHA_DISABLE_LOCAL_ENV=false
ORCHA_API_HOST=0.0.0.0
ORCHA_API_PORT=8080
ORCHA_DATABASE_URL=sqlite:///./orcha.db
ORCHA_EVENT_BUS=in_memory
ORCHA_WORKSPACE_ROOT=/var/lib/orcha/workspaces
ORCHA_VM_ID=local-dev-vm
ORCHA_SIGNING_KEY=replace-in-development
ORCHA_DEFAULT_MODEL=provider/model-name
ORCHA_MODEL_API_KEY=
# Persistent agent runtime. Set these on the API host only—never in Vite or the browser.
# Supported today: openrouter, gemini, groq, openai. The model must be explicitly selected.
ORCHA_AGENT_PROVIDER=
ORCHA_AGENT_MODEL=
# Optional per-provider overrides for a mixed fallback chain. When set, these
# take precedence over ORCHA_AGENT_MODEL for that provider.
ORCHA_AGENT_OPENROUTER_MODEL=
ORCHA_AGENT_GEMINI_MODEL=
ORCHA_AGENT_GROQ_MODEL=
ORCHA_AGENT_OPENAI_MODEL=
ORCHA_AGENT_FALLBACK_PROVIDERS=gemini,groq
ORCHA_MAX_AGENT_RUNS_PER_DAY=40
# Use zero for a free-tier provider. Add real rates only if the provider bills you.
ORCHA_AGENT_INPUT_USD_PER_1K=0
ORCHA_AGENT_OUTPUT_USD_PER_1K=0
ORCHA_AGENT_MAX_ESTIMATED_RUN_USD=0.25
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional ordered comma-separated pools for temporary keys. These remain on
# the API host and are tried only after the matching provider's prior key fails.
OPENROUTER_API_KEYS=
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENAI_API_KEYS=
# Failed temporary keys are skipped briefly in-memory before a recovery retry.
ORCHA_AGENT_KEY_COOLDOWN_SECONDS=60
ORCHA_TELEMETRY_ENABLED=false
ORCHA_MAX_COMPANY_BUDGET_USD=25
ORCHA_APPROVAL_MODE=consequential-only
ORCHA_WORKER_URL=http://127.0.0.1:8765
ORCHA_WSL_DISTRO=orcha-worker
ORCHA_SANDBOX_PROVIDER=local_wsl
# Optional for a private CloudSandboxManager worker. Keep only in host/secret storage.
ORCHA_WORKER_AUTH_TOKEN=
# Set true for any shared/container deployment so a missing token fails closed.
ORCHA_REQUIRE_WORKER_AUTH=false
ORCHA_FEEDBACK_DIR=var/feedback
